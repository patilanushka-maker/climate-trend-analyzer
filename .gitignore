# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & local secrets
.env
.env.local
.env.*.local
!.env.example
.streamlit/secrets.toml

# Log files
*.log

# Temporary and swap files
*.tmp
*.bak
*.swp
*~

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Unit test / coverage reporting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# IDE and OS Clutter
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Data Files (preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Generated Outputs & Reports (preserve directory structure via .gitkeep)
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/summaries/*
!outputs/summaries/.gitkeep
reports/*
!reports/.gitkeep
!reports/*.md
